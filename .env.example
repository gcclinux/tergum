# Tergum Service Environment Configuration
# Copy this file to .env and adjust values for your deployment.
# The .env file is loaded automatically by `tergum service start`.

# Required: Passphrase used for encryption key derivation.
TERGUM_PASSPHRASE=your-secure-passphrase-here

# Optional: Path to configuration file (defaults to platform-specific tergum.toml).
# TERGUM_CONFIG=

# Optional: Log level (debug, info, warn, error). Defaults to info.
# TERGUM_LOG_LEVEL=info
